[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    features = side-by-side line-numbers decorations
    navigate = true
    light = false
# [diff]
# 	external = difft
[user]
	name = iemafzalhassan
	email = iemafzalhassan@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[safe]
	directory = *
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	program = /usr/bin/ssh-keygen
[tag]
	gpgsign = true
